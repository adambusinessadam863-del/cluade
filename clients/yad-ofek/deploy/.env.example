# ---- חיבור לוואטסאפ: בחרו מצב אחד ----
# מצב meta: ישירות מול Meta (מספר חדש שלא באפליקציית וואטסאפ)
WA_MODE=meta
PHONE_NUMBER_ID=
WA_TOKEN=
VERIFY_TOKEN=choose-a-long-random-string
APP_SECRET=
GRAPH_VERSION=v23.0
# מצב bsp: דרך ספק מאושר (למשל כדי להשאיר את מספר אפליקציית ה-Business). אז:
#   WA_MODE=bsp
#   WA_SEND_URL=<כתובת השליחה שהספק נותן>
#   WA_TOKEN=<מפתח ה-API של הספק>
#   WEBHOOK_PATH=/webhook/<מחרוזת-אקראית-ארוכה>   (מכניסים את הכתובת המלאה בהגדרות הספק)

# ---- התראות לבעל העסק (טלגרם, חינם) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- ניהול ----
ADMIN_TOKEN=choose-another-long-random-string
DOMAIN=bot.example.co.il

# ---- אופציונלי: הבנת תשובות חופשיות עם Claude ----
ANTHROPIC_API_KEY=
