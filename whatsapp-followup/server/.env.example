# --- חובה ---
# מפתח האימות שאתם בוחרים ומזינים גם בהגדרות ה-Webhook ב-Meta
VERIFY_TOKEN=choose-a-long-random-string
# ה-App Secret של אפליקציית Meta (לאימות חתימה של כל הודעה נכנסת)
APP_SECRET=
# טוקן קבוע (System User) עם הרשאת whatsapp_business_messaging
WA_TOKEN=
# מזהה מספר הטלפון (Phone number ID) מלוח המחוונים של WhatsApp ב-Meta
PHONE_NUMBER_ID=
# שם העסק כפי שיופיע בהודעות, ותהליך השיחה: driving | reno | pilates | moving
BUSINESS_NAME=שם העסק
FLOW=driving

# --- התראות לבעל העסק (חינם, מומלץ) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- תבניות מעקב מאושרות ב-Meta (לשליחה אחרי 24 שעות בלי תגובה) ---
TEMPLATE_FU_2=followup_day
TEMPLATE_FU_3=followup_last

# --- אופציונלי ---
# שכבת Claude להבנת תשובות חופשיות. אם ריק, הבוט מציג שוב את האפשרויות.
ANTHROPIC_API_KEY=
# תזכורת לבעל העסק אם הליד לא טופל (בדקות). 0 = כבוי
OWNER_REMINDER_MIN=0
# מפעיל נקודות /leads ו-/ack (Authorization: Bearer ...). ריק = כבויות
ADMIN_TOKEN=
# גרסת Graph API: בדקו את הגרסה הנוכחית בתיעוד של Meta
GRAPH_VERSION=v23.0
PORT=3000
DATA_FILE=./data/leads.json
